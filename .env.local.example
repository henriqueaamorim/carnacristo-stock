NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Chave "anon" / "publishable" (pública) — Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Chave "service_role" / "secret" (NUNCA use a anon aqui) — Settings → API
# Necessária para cadastro/edição/exclusão de usuários em /api/admin/usuarios
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key
